# ================================================================
# Pharmacy Management System (PMS) - .gitignore
# ================================================================

# ----- Dependencies ---------------------------------------------
/vendor/
/node_modules/
composer.phar
package.json
package-lock.json

# ----- Environment -----------------------------------------------
.env
.env.production
.env.local
.env.*.local
# Never commit credentials. Use .env.example as the template.

# ----- Databases, Sessions, Dumps & Backups -----------------------
*.sqlite
*.sqlite3
*.db
/storage/backups/
database/database.sqlite
database/sessions/
database/dumps/
database/migrations/

# ----- Build, Installers & Desktop App Setup --------------------
/dist/
/build/
main.js
*.exe
*.msi
*.dmg
*.AppImage
*.blockmap
/scratch/
result.txt
alshafa_templates.html
thermal_templates.html

# ----- Uploads (user-generated content) -------------------------
public/uploads/products/
public/uploads/profiles/
uploads/

# ----- Logs & Storage --------------------------------------------
*.log
logs/
storage/logs/
storage/cache/
.phpunit.cache/

# ----- OS & Editor files ----------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# ----- Temporary / debug / scratch files ------------------------
tmp_*.php
debug_*.php
test_*.php
check_*.php

# ----- Internal Specification & Design Documents ----------------
SRS.md
SDD.md
design.md
