# ================================================================
# Inventory Management System - Environment Configuration Example
# ================================================================
# Copy this file to .env and fill in your actual values.
# The .env file must NEVER be committed to version control.
# ================================================================

# ----- Application -----------------------------------------------
APP_NAME="Pharmacy Management System"
APP_ENV=local
# Options: local, staging, production
APP_DEBUG=true
# Set to false in production
APP_URL=http://localhost/new_system/public

# ----- Database --------------------------------------------------
DB_DRIVER=sqlite
# Options: sqlite, mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=PMS_db
DB_USER=root
DB_PASS=

# ----- Session ---------------------------------------------------
SESSION_LIFETIME=86400
# In seconds: 86400 = 24 hours
SESSION_SECURE=false
# Set to true when using HTTPS in production
SESSION_SAMESITE=Strict

# ----- File Uploads ----------------------------------------------
UPLOAD_MAX_SIZE=5242880
# In bytes: 5242880 = 5 MB
UPLOAD_PATH=public/uploads

# ----- Security --------------------------------------------------
FORCE_HTTPS=false
# Set to true in production to redirect all HTTP to HTTPS

# ----- Rate Limiting ---------------------------------------------
RATE_LIMIT_MAX_ATTEMPTS=5
# Max failed logins before lockout
RATE_LIMIT_DECAY_MINUTES=15
# Lockout duration in minutes
RATE_LIMIT_BY_IP=true
# Track by IP address (recommended)

# ----- Proxy Configuration ---------------------------------------
TRUSTED_PROXIES=false
# Set to true when running behind a reverse proxy (e.g., Cloudflare, AWS ALB)
